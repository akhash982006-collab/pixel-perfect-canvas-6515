rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isCoordinator() {
      return request.auth != null
        && request.auth.token.email == "laptopnodell@gmail.com";
    }

    match /admins/{uid} {
      allow read: if isCoordinator() && request.auth.uid == uid;
      allow write: if false;
    }

    match /quizzes/{quizId} {
      allow create: if isCoordinator()
        && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if isCoordinator()
        && resource.data.teacherId == request.auth.uid;
      allow read: if isCoordinator() || resource.data.published == true;
    }

    match /attempts/{attemptId} {
      allow read: if isCoordinator();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}